# .env.example
# Nunca comite seu .env real!

DISCORD_TOKEN=COLE_SEU_TOKEN_AQUI

# Opcional
COMMAND_PREFIX=!
LOOP_MINUTES=720
# Quantos feeds buscar em paralelo por varredura
FEED_CONCURRENCY=8
# Teto de publicações por fonte em cada varredura (0 = sem limite).
# Impede que um canal que sobe 15 vídeos no dia ocupe o canal sozinho;
# o resto fica para a rodada seguinte.
MAX_ITENS_POR_FONTE=5
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Web dashboard (segurança)
# WEB_ENABLED=true
# WEB_HOST=127.0.0.1
# WEB_PORT=8080
# Se definido, /api/stats exige: Authorization: Bearer <mesmo_valor>
# WEB_API_SECRET=
